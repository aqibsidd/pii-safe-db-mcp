{
  "name": "pii-safe-db-mcp",
  "version": "0.2.0",
  "description": "MCP server for MySQL & PostgreSQL that masks PII before it reaches the LLM, with SQL AST policy enforcement (no sensitive columns in WHERE/JOIN/GROUP BY/ORDER BY), table allowlists, audit logging and Indian PII recognisers. Read-only by design.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mysql",
    "postgres",
    "postgresql",
    "pii",
    "data-masking",
    "privacy",
    "llm",
    "claude",
    "gdpr",
    "dpdp",
    "sql-ast",
    "audit-log",
    "aadhaar",
    "pan",
    "gstin",
    "upi",
    "dpdp-act",
    "data-governance",
    "postgres-mcp",
    "mysql-mcp"
  ],
  "author": "Aqib Siddiqui",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "mysql2": "^3.24.6",
    "node-sql-parser": "^5.4.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  },
  "bin": {
    "pii-safe-db-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aqibsidd/pii-safe-db-mcp.git"
  },
  "homepage": "https://github.com/aqibsidd/pii-safe-db-mcp#readme",
  "bugs": {
    "url": "https://github.com/aqibsidd/pii-safe-db-mcp/issues"
  }
}
